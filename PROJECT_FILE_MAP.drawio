                <mxCell id="legend2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" value="Build scripts create generated files under build/ and bin/. The workload executables are separate programs used by the automated runner and GUI/CLI demonstrations." vertex="1">
                    <mxGeometry height="40" width="1400" x="45" y="775" as="geometry"/>
                </mxCell>
            </root>
